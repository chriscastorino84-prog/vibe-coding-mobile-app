{
  "expo": {
    "name": "Fitness Applied",
    "slug": "fitness-applied",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnessapplied.mobile"
    },
    "android": {
      "package": "com.fitnessapplied.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "fitnessapplied",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow this app to save your progress photos.",
          "cameraPermission": "Allow this app to take progress photos."
        }
      ],
      "expo-sqlite"
    ]
  }
}
