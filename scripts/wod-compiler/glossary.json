    { "terms": ["death by", "death-by", "ascending emom", "progressive emom", "ascending minute ladder"], "value": "death_by", "note": "Minute 1: 1 rep, minute 2: 2 reps, until the reps no longer fit in the minute. Score is the last full minute." },
    { "terms": ["tabata", "20 on 10 off", "20 seconds on 10 seconds off"], "value": "tabata", "note": "8 × (20 s work, 10 s rest) per movement; score is total reps or the lowest round." },
