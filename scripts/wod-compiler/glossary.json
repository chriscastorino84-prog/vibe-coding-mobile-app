    { "terms": ["for load", "for max load", "ahap", "as heavy as possible", "hap", "heavy as possible", "heavy", "1rm", "2rm", "3rm", "5rm", "rep max", "build to", "work up to", "establish a", "crossfit total", "cft", "find a"], "value": "strength", "note": "Sets at a load; score is the heaviest load." },
